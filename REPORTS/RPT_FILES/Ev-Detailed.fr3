<TfrxReport Version="6.6.11" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.AllowEdit="False" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.Author="Ben Ambrose" ReportOptions.CreateDate="43428.811813125" ReportOptions.Description.Text="" ReportOptions.Name="Sys-Event-Detailed" ReportOptions.LastChange="46262.4861240625" ScriptLanguage="PascalScript" ScriptText.Text="var&#13;&#10; EnablePrintClubLogo: boolean;&#13;&#10;&#13;&#10;procedure Page1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;    // Set default coordinates (using fr1cm to convert 1.75 cm to pixels)&#13;&#10;  FClubName.Left := 0;&#13;&#10;  FNickName.Left := 0;&#13;&#10;&#13;&#10;  // Reference the script variable directly as a boolean (no brackets)&#13;&#10;  if (EnablePrintClubLogo = true) then&#13;&#10;  begin&#13;&#10;    // Check if the database BLOB field is Null [6]&#13;&#10;    if &#60;SwimClub.&#34;LogoImg&#34;&#62; = Null then&#13;&#10;    begin&#13;&#10;      FLogo.Visible := False;&#13;&#10;    end&#13;&#10;    else&#13;&#10;    begin&#13;&#10;      FLogo.Visible := True;&#13;&#10;      FClubName.Left := 1.75 * fr1cm;&#13;&#10;      FNickName.Left := 1.75 * fr1cm;&#13;&#10;    end;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    FLogo.Visible := false;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10; EnablePrintClubLogo := false;&#13;&#10;end.">
